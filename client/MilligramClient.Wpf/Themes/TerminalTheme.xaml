<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro">

    <!-- Базовые цвета и шрифт для «терминального» оформления -->
    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="TerminalForegroundBrush" Color="#00FF00" />
    <SolidColorBrush x:Key="TerminalAccentBrush" Color="#33FF33" />
    <SolidColorBrush x:Key="TerminalMenuButtonBrush" Color="#808080" />
    <SolidColorBrush x:Key="TerminalMessageTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TerminalMessageTimeBrush" Color="#AAAAAA" />
    <SolidColorBrush x:Key="TerminalSeparatorBrush" Color="#404040" />
    <SolidColorBrush x:Key="TerminalBorderGray" Color="#2A2A2A" />
    <FontFamily x:Key="TerminalFontFamily">Consolas</FontFamily>

    <!-- Переопределение для основного окна MahApps.Metro -->
    <Style TargetType="{x:Type mah:MetroWindow}">
        <Setter Property="Background" Value="{StaticResource TerminalBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TerminalForegroundBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TerminalFontFamily}" />
    </Style>

    <!-- NOTE: стиль смайликов задаётся на месте использования, чтобы не создавать зависимость типов в словаре -->

    <!-- Общий стиль для контролов -->
    <Style TargetType="Control">
        <Setter Property="Background" Value="{StaticResource TerminalBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TerminalForegroundBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TerminalFontFamily}" />
    </Style>

    <!-- TextBox: тёмный фон, зелёный текст, прозрачная рамка -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource TerminalBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TerminalForegroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CaretBrush" Value="{StaticResource TerminalForegroundBrush}" />
    </Style>

    <!-- Button: минималистичный вид, без рамки -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TerminalMenuButtonBrush}" />
        <Setter Property="Padding" Value="6,2" />
    </Style>

    <!-- ListView и элементы списка -->
    <Style TargetType="ListView">
        <Setter Property="Background" Value="{StaticResource TerminalBackgroundBrush}" />
        <!-- Текст в списке контактов/чатов должен быть белым -->
        <Setter Property="Foreground" Value="{StaticResource TerminalMessageTextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent" />
        <!-- По умолчанию текст элементов списка белый -->
        <Setter Property="Foreground" Value="{StaticResource TerminalMessageTextBrush}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource TerminalBorderGray}" />
                            <Setter Property="Foreground" Value="{StaticResource TerminalAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#080808" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
